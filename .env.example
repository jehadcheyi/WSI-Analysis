# ── HistoAI backend environment ───────────────────────────────
# Copy to .env and fill in:  cp .env.example .env

# HuggingFace token (for MahmoodLab/conchv1_5 + TITAN)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Classifier checkpoint location (inside the container)
CLASSIFIER_PATH=/model/bracs_v3_model.pkl

# Max upload size in MB (default 10 GB)
MAX_UPLOAD_MB=10000
